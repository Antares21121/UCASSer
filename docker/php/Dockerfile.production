FROM composer:2.10.3 AS composer
FROM php:8.3.35-fpm-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    libfreetype6-dev libjpeg62-turbo-dev libpng-dev libzip-dev libonig-dev libicu-dev libxml2-dev unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j2 gd mbstring pdo_mysql zip intl dom opcache \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
COPY docker/php/php.ini /usr/local/etc/php/conf.d/forum.ini
COPY docker/php/zz-forum.conf /usr/local/etc/php-fpm.d/zz-forum.conf
# Production-only PHP hardening: the image is immutable so opcache never needs
# to revalidate timestamps, and production always serves HTTPS so session
# cookies can require the secure flag. The development image keeps none of this.
RUN printf 'opcache.validate_timestamps=0\nopcache.memory_consumption=128\nsession.cookie_secure=1\n' > /usr/local/etc/php/conf.d/zz-production.ini
WORKDIR /var/www/forum
COPY extensions/ucasser-resources ./extensions/ucasser-resources
COPY composer.json composer.lock ./
COPY extensions ./extensions
RUN composer install --no-dev --prefer-dist --no-interaction --no-plugins --no-scripts
COPY . .
RUN php scripts/prepare-runtime.php
RUN php scripts/release.php
RUN mkdir -p storage/cache storage/formatter storage/less storage/locale storage/logs storage/sessions storage/tmp storage/views public/assets/avatars \
    && printf "<?php\nreturn require __DIR__.'/config/environment.php';\n" > config.php \
    && chown -R www-data:www-data storage public/assets
USER www-data
