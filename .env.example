# Project launcher variables, NOT variables natively read by Flarum.
APP_ENV=development
APP_URL=http://127.0.0.1:8080
FORUM_TITLE=校园公共论坛（开发）
APP_DEBUG=false
TZ=Asia/Shanghai
LOG_LEVEL=warning
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
COMPOSE_PROJECT_NAME=campus-forum-dev
DB_HOST=db
DB_PORT=3306
DB_NAME=campus_forum
DB_USER=forum
# setup generates local random passwords; never commit real values.
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PREFIX=
NATIVE_DB_PORT=3307
BACKUP_DIR=backups
# Future SMTP configuration: apply in Flarum admin, these are placeholders only.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
